{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(self)"
      },
      "continue": true
    },
    {"src": "/order", "dest": "/order.html"},
    {"src": "/table/(.*)", "dest": "/order.html"}
  ]
}
